# MediSync AI - Environment Configuration Example
# Copy to .env and replace placeholders with secure secrets in production

FLASK_ENV=development
SECRET_KEY=change-to-a-cryptographically-secure-random-key-in-production

# Database URL:
# For local SQLite development (default):
DATABASE_URL=sqlite:///medisync_dev.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://medisync_user:secure_password@localhost:5432/medisync_db

# Email / Notification credentials (optional dev mode logs locally)
MAIL_ENABLED=false
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_smtp_api_key_placeholder

# Service pacing
AVERAGE_SERVICE_MINUTES=15
WAITLIST_OFFER_EXPIRY_HOURS=2
